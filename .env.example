# ============================================================
# AI Knowledge Assistant — environment example
# Salin ke .env dan sesuaikan. JANGAN commit file .env sungguhan.
# ============================================================

# --- Umum ---
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# --- Backend API (http://localhost:8000) ---
# Database: host 5433 karena 5432 di Mac ini sudah terpakai layanan lain
APP_DATABASE_URL=postgresql+psycopg://ai_assistant:ai_assistant@localhost:5433/ai_assistant
# Redis: host 6380 karena 6379 sudah terpakai
APP_REDIS_URL=redis://localhost:6380/0

# --- Audit (opsional; kosong = hanya ke tabel audit_events) ---
APP_AUDIT_LOG_FILE=

# --- Upload (Fase 3) ---
# APP_MAX_UPLOAD_BYTES=104857600   # 100 MB (default)
# APP_PRESIGN_EXPIRY_SECONDS=900   # umur signed URL download (default 900)

# --- Object storage (MinIO di Docker) ---
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=ai-assistant
APP_MINIO_SECURE=false

# --- AI provider adapter (diisi di Fase 6; kosongkan dulu) ---
APP_LLM_PROVIDER=openai
APP_OPENAI_API_KEY=
APP_ANTHROPIC_API_KEY=
APP_GEMINI_API_KEY=
APP_LOCAL_LLM_BASE_URL=http://localhost:11434

# --- Ingestion & Indexing (Fase 4/5) ---
# APP_CHUNK_TARGET_TOKENS=512
# APP_CHUNK_OVERLAP_TOKENS=64
# APP_EMBEDDING_PROVIDER=local        # local | openai
# APP_EMBEDDING_DIM=384
# APP_OPENAI_API_KEY=
# APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend (http://localhost:3000) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Docker Compose (dipakai oleh container, bukan host) ---
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=ai_assistant
POSTGRES_DB=ai_assistant
