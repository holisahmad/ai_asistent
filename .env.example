# ============================================================
# AI Knowledge Assistant — environment example
# Salin ke .env dan sesuaikan. JANGAN commit file .env sungguhan.
# ============================================================

# --- Umum ---
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# --- Backend API (http://localhost:8000) ---
# Database: host 5433 karena 5432 di Mac ini sudah terpakai layanan lain
APP_DATABASE_URL=postgresql+psycopg://ai_assistant:ai_assistant@localhost:5433/ai_assistant
# Redis: host 6380 karena 6379 sudah terpakai
APP_REDIS_URL=redis://localhost:6380/0

# --- Audit (opsional; kosong = hanya ke tabel audit_events) ---
APP_AUDIT_LOG_FILE=

# --- Upload (Fase 3) ---
# APP_MAX_UPLOAD_BYTES=104857600   # 100 MB (default)
# APP_PRESIGN_EXPIRY_SECONDS=900   # umur signed URL download (default 900)

# --- Object storage (MinIO di Docker) ---
APP_MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=ai-assistant
APP_MINIO_SECURE=false

# --- LLM adapter (Fase 6/7) ---
# local           = stub deterministik (dev/test, tanpa API)
# openai          = SDK resmi (api.openai.com)
# openai_compat   = endpoint OpenAI-compatible apa pun (vLLM/gateway lokal),
#                   set APP_OPENAI_BASE_URL
APP_LLM_PROVIDER=local
# APP_LLM_PROVIDER=openai
# APP_LLM_PROVIDER=openai_compat
# APP_OPENAI_BASE_URL=http://localhost:20128/v1
APP_OPENAI_API_KEY=
APP_OPENAI_CHAT_MODEL=gpt-4o-mini
# APP_OPENAI_TIMEOUT_SECONDS=60

# --- Web fallback (Fase 7) ---
# internal_only = hanya knowledge base; internal_plus_web = boleh cari web bila
# bukti internal tak cukup DAN klien mengirim allow_web=true
APP_WEB_FALLBACK_MODE=internal_only
# none | bing_rss (tanpa key, rekomendasi) | duckduckgo (tanpa key) | searx (self-host) | tavily (API key)
APP_WEB_SEARCH_PROVIDER=none
# APP_WEB_SEARCH_BASE_URL=http://localhost:8888
# APP_TAVILY_API_KEY=
# APP_WEB_SEARCH_MAX_RESULTS=5
# Market/locale Bing RSS (mkt + setlang) — biaskan hasil ke Bahasa Indonesia.
# Kosongkan untuk default mesin pencari.
# APP_WEB_SEARCH_MARKET=id-ID
# APP_WEB_SEARCH_RATE_LIMIT_PER_MIN=10
# APP_WEB_SEARCH_DOMAIN_ALLOWLIST_CSV=perusahaan.com,docs.internal
# APP_WEB_SEARCH_DOMAIN_DENYLIST_CSV=facebook.com,tiktok.com
# Ambang kecukupan bukti web (Fase 7/9): hasil dengan skor relevansi di bawah
# ambang dibuang; bila yang lolos < min_results → no_answer (konteks lemah
# tidak disuntik ke prompt).
# APP_WEB_EVIDENCE_MIN_RELEVANCE=0.34
# APP_WEB_EVIDENCE_MIN_RESULTS=1

# --- CORS (dipakai backend untuk frontend) ---
# APP_CORS_ORIGINS_CSV=http://localhost:3000

# --- Ketahanan panggilan eksternal (Fase 9) ---
# Retry/backoff + circuit breaker untuk LLM & web search.
# APP_EXTERNAL_MAX_ATTEMPTS=3
# APP_EXTERNAL_RETRY_BASE_SECONDS=0.5
# APP_EXTERNAL_RETRY_MAX_SECONDS=8
# APP_BREAKER_FAILURE_THRESHOLD=5
# APP_BREAKER_RECOVERY_SECONDS=60

# --- Perlindungan API & observability (Fase 9) ---
# APP_API_RATE_LIMIT_PER_MIN=120   # per user/token; 0 = nonaktif
# APP_API_RATE_LIMIT_BURST=0       # kuota tambahan sekali jalan
# APP_METRICS_TOKEN=               # bila diset, GET /metrics butuh Bearer token ini
# APP_REQUEST_ID_HEADER=X-Request-ID

# --- Retrieval (Fase 6) ---
# APP_RETRIEVAL_TOP_K=6           # jumlah konteks yang dikirim ke LLM
# APP_RETRIEVAL_CANDIDATES=24     # kandidat dense/keyword sebelum fusi
# APP_RETRIEVAL_MIN_SCORE=0.05    # threshold skor terfusi
# APP_RAG_MAX_CONTEXT_CHARS=6000  # batas total konteks per pertanyaan

# --- Ingestion & Indexing (Fase 4/5) ---
# APP_CHUNK_TARGET_TOKENS=512
# APP_CHUNK_OVERLAP_TOKENS=64
APP_EMBEDDING_PROVIDER=local          # local | openai
# APP_EMBEDDING_DIM=384
# APP_OPENAI_API_KEY=
# APP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Frontend (http://localhost:3000) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Docker Compose (dipakai oleh container, bukan host) ---
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=ai_assistant
POSTGRES_DB=ai_assistant
