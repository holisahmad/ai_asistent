# Dockerfile.worker — RQ Worker untuk Railway
# Cache-bust: v1
FROM python:3.12-slim

WORKDIR /app

# System deps (sama dengan backend)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv==0.4.29

ARG CACHE_BUST=v1

# Copy source
COPY pyproject.toml uv.lock ./
COPY core/ ./core/
COPY worker/ ./worker/

# Install semua deps termasuk worker-specific
RUN uv pip install --system --no-cache \
    "pydantic>=2.10" \
    "pydantic-settings>=2.7" \
    "psycopg[binary]>=3.2" \
    "sqlalchemy>=2.0" \
    "alembic>=1.14" \
    "redis>=5.2" \
    "pgvector>=0.3" \
    "rq>=2.1" \
    "pypdf>=5.1" \
    "python-docx>=1.1" \
    "python-pptx>=1.0" \
    "openpyxl>=3.1" \
    "httpx>=0.28" \
    "boto3>=1.34"

# Install core package
RUN pip install --no-cache-dir -e ./core

# Install worker package
RUN pip install --no-cache-dir -e ./worker

ENV PYTHONPATH="/app/core/src:/app/worker/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY docker-entrypoint-worker.sh /docker-entrypoint-worker.sh
RUN chmod +x /docker-entrypoint-worker.sh

ENTRYPOINT ["/docker-entrypoint-worker.sh"]
